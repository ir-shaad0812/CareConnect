# ============================================
# CareConnect Backend  Environment Variables
# ============================================
# Copy this file to .env and fill in YOUR OWN values.
# NEVER commit the real .env file or any file containing real secrets.
# Rotate ALL credentials immediately if this file was ever committed with real values.
# ============================================

#  Server 
NODE_ENV=development
PORT=5000

#  MongoDB 
# Use a connection string from MongoDB Atlas or a local instance
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>

#  JWT 
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Access and refresh secrets MUST be different and at least 64 characters.
JWT_ACCESS_SECRET=<generate-64-char-random-hex>
JWT_REFRESH_SECRET=<generate-different-64-char-random-hex>
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

#  Cookie 
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
COOKIE_SECRET=<generate-32-char-random-hex>

#  Frontend URL (CORS + OAuth redirects) 
FRONTEND_URL=http://localhost:3000
# Production: FRONTEND_URL=https://yourdomain.com

#  Google OAuth 
# Get from https://console.cloud.google.com/  APIs & Services  Credentials
GOOGLE_CLIENT_ID=<your-google-client-id>.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=<your-google-client-secret>
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback
# Production: GOOGLE_CALLBACK_URL=https://api.yourdomain.com/api/auth/google/callback

#  Admin Seed (never use real admin password here) 
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=<strong-password-min-12-chars>
ADMIN_NAME=Admin User
ADMIN_IS_SUPER=true

#  Cloudinary (document / avatar storage) 
# Get from https://console.cloudinary.com/
CLOUDINARY_CLOUD_NAME=<your-cloud-name>
CLOUDINARY_API_KEY=<your-api-key>
CLOUDINARY_API_SECRET=<your-api-secret>

#  SMTP Email 
# For Gmail: use an App Password (NOT your account password)
# Enable 2FA then create at https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=<your-email@gmail.com>
SMTP_PASS=<your-gmail-app-password>
SMTP_FROM=CareConnect <noreply@yourdomain.com>

#  WebRTC TURN Server (optional — improves call reliability behind strict NAT)
# Any TURN provider works: Coturn (self-hosted), Twilio TURN, Metered.ca, etc.
# Leave blank to use public STUN servers only (sufficient for most networks)
# TURN_SERVER_URL=turn:your-turn-server.com:3478
# TURN_USERNAME=<your-turn-username>
# TURN_CREDENTIAL=<your-turn-password>

#  Stripe (Payments)
# Test keys from https://dashboard.stripe.com/test/apikeys
# Use sk_live_* and pk_live_* only in production
STRIPE_SECRET_KEY=sk_test_<your-stripe-secret-key>
STRIPE_PUBLISHABLE_KEY=pk_test_<your-stripe-publishable-key>
STRIPE_WEBHOOK_SECRET=whsec_<your-webhook-secret>

# Redis Queue (BullMQ)
# Set REDIS_ENABLED=true to enable async notification workers.
# REDIS_URL is recommended for cloud Redis providers.
REDIS_ENABLED=false
REDIS_URL=redis://127.0.0.1:6379
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_QUEUE_PREFIX=careconnect

# eSewa Payment Gateway (Epay-v2, Nepal)
# Test credentials: https://developer.esewa.com.np/pages/Epay
ESEWA_MERCHANT_CODE=EPAYTEST
ESEWA_SECRET_KEY=<your-esewa-secret-key>
ESEWA_API_URL=https://rc-epay.esewa.com.np
ESEWA_CLIENT_ID=<your-esewa-client-id>
ESEWA_CLIENT_SECRET=<your-esewa-client-secret>

# Khalti Payment Gateway (Nepal) - e-Payment v2
# IMPORTANT: Keys must be in format "live_secret_key_xxx" or "test_secret_key_xxx"
# Get from https://admin.khalti.com/ → Settings → Keys
# Test key example: test_secret_key_dc74e0fd57cb46cd93832aee0a507256
# KHALTI_SECRET_KEY=test_secret_key_dc74e0fd57cb46cd93832aee0a507256
# KHALTI_PUBLIC_KEY=test_public_key_dc74e0fd57cb46cd93832aee0a390734
# KHALTI_API_URL=https://a.khalti.com/api/v2
